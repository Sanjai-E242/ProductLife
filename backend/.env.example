# ProductLife Backend Environment Configuration Example
# Copy to .env or set in your environment

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database configuration (Optional - by default, runs embedded zero-setup H2 database)
# To use external MySQL:
# DB_URL=jdbc:mysql://127.0.0.1:3306/productlife?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=productlife_app
# DB_PASSWORD=your_mysql_password
